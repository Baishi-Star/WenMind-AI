# WenMind AI 后端环境变量示例
# 复制为 .env 后修改；.env 已被 .gitignore 忽略，禁止提交真实密钥。

APP_NAME=WenMind AI
APP_VERSION=0.3.0
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite 默认位于 backend/data/wenmind.db；也可填写其他 SQLAlchemy 连接串
# DATABASE_URL=sqlite:///./data/wenmind.db
AUTO_INIT_DB=true
AUTO_SEED_DEMO=true

# 生产环境必须填写高强度随机值；开发环境留空会生成临时随机密钥，重启后旧令牌失效
JWT_SECRET_KEY=
# 演示账号初始密码。留空时首次初始化会随机生成并打印到后端日志；不得使用生产密码
DEMO_PASSWORD=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
PASSWORD_HASH_ITERATIONS=600000
ESSAY_MAX_CHARS=20000

# 大模型：默认显式 Mock，不在源码中硬编码密钥
LLM_MOCK_MODE=true
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
# 推理模型会消耗 completion tokens 进行思考，预算不足会导致 JSON 截断
LLM_MAX_TOKENS=8192
# 部分服务支持 response_format=json_object；不支持时保持 false
LLM_JSON_MODE=false
# RAG：auto=配置完整时远程，否则明确使用本地 TF-IDF 词汇检索（非语义）
# remote=强制远程，失败不静默降级；local_tfidf=本地词汇向量 + FAISS
EMBEDDING_MODE=auto
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=60
KNOWLEDGE_UPLOAD_MAX_MB=10
KNOWLEDGE_CHUNK_TARGET_CHARS=300
KNOWLEDGE_CHUNK_MAX_CHARS=500
# 规则建议：同一教师确认标签达到最小案例数后生成待审核建议
RULE_PROPOSAL_MIN_CASES=3
RULE_PROPOSAL_WINDOW_DAYS=30
# 成长画像：少于 3 篇显示数据积累中；近期窗口与弱项阈值
GROWTH_MIN_SAMPLES=3
GROWTH_RECENT_WINDOW=3
GROWTH_WEAK_THRESHOLD=3.5