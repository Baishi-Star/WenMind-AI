# WenMind AI 后端环境变量示例
# 使用方法：复制为 .env 后按本机情况修改；.env 已被 .gitignore 忽略，禁止提交真实密钥。

# ---------- 应用 ----------
APP_NAME=WenMind AI
APP_VERSION=0.1.0
# development / testing / production
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# 允许访问后端的前端来源，多个来源用英文逗号分隔
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 大模型（阶段 1 仅占位，不在源码中硬编码任何密钥） ----------
# true 时使用显式标注的 Mock 模式；切换真实调用前必须填好以下三项并改为 false
LLM_MOCK_MODE=true
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60